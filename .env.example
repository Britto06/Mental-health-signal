# Copy this to .env (or set these in Render's Environment settings) and fill in real values.
# Without these, the scheduler still runs but only prints what it WOULD have sent.

# --- MongoDB Database ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mental_health_signal

# --- Email channel ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-character-app-password
FROM_EMAIL=your@gmail.com

# --- WhatsApp channel (Twilio) ---
# Get these from console.twilio.com. The sandbox number below works for
# testing without approval; production needs a WhatsApp Business number.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

SITE_URL=https://your-deployed-site.example.com
